---
import AboutSummary from '../components/AboutSummary.astro';
import CvDownload from '../components/CvDownload.astro';
import HeroGraph from '../components/HeroGraph.astro';
import HeroTitle from '../components/HeroTitle.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getProfile } from '../lib/content';
import { heroGraph } from '../lib/hero-graph';

const { name, headline } = await getProfile();
---

<SiteLayout
  title="Dennis Ferreira | Technical Marketing Developer"
  description="An interactive portfolio for sharing professional experience and work."
  sections={[
    { id: 'intro', label: 'Intro' },
    { id: 'about', label: 'About' },
  ]}
>
  <PageHero id="intro" eyebrow={name} title={heroGraph.shapes[0].label} scatter>
    <HeroTitle slot="title" />
    <HeroGraph slot="animation" />
    <p class="lead">{headline}</p>
    <p><a href="/experience/">Explore experience</a></p>
    <CvDownload />
  </PageHero>
  <AboutSummary />
</SiteLayout>
