---
import AreaIcon from '../components/AreaIcon.astro';
import PhysicsPlaceholder from '../components/PhysicsPlaceholder.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPlatforms, getProfile } from '../lib/content';

const { focusAreas } = await getProfile();
const platforms = await getPlatforms();
---

<SiteLayout
  title="Skills | Professional portfolio"
  description="Focus areas and the platforms used across website development, CRM integration, analytics, and technical SEO."
  sections={[
    { id: 'focus-areas', label: 'Focus areas' },
    { id: 'platforms', label: 'Platforms' },
    { id: 'interactive', label: 'Interactive' },
  ]}
>
  <section>
    <h1>Skills</h1>
    <p class="lead">
      My work connects the website platform, campaign experiences, marketing automation, analytics, regional content,
      and lead-conversion workflows.
    </p>
  </section>
  <section id="focus-areas">
    <h2>Focus areas</h2>
    <ul>
      {focusAreas.map((area) => <li>{area}</li>)}
    </ul>
  </section>
  <section id="platforms">
    <h2>Platforms</h2>
    <dl class="platforms">
      {
        platforms.map(({ name, uses }) => {
          const areas = [...new Map(uses.map((use) => [use.area, use])).values()];
          const accents = [...new Set(areas.flatMap(({ accent }) => (accent ? [accent] : [])))];
          const first = areas.find(({ accent }) => accent);
          return (
            <div class="reveal" data-morph={first?.accent} data-morph-label={first?.area}>
              <dt>
                {name}
                <span class="area-icons">
                  {accents.map((accent) => (
                    <AreaIcon accent={accent} />
                  ))}
                </span>
              </dt>
              <dd>{areas.map(({ area }) => area).join('; ')}</dd>
            </div>
          );
        })
      }
    </dl>
  </section>
  <PhysicsPlaceholder id="interactive" label="Skills animation" />
</SiteLayout>

<style>
  .platforms {
    display: grid;
    gap: var(--row-gap) var(--column-gap);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .platforms dt {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-weight: 700;
    gap: 0.5rem;
  }

  .area-icons {
    display: inline-flex;
    gap: 0.25rem;
  }

  .platforms dd {
    margin: 0;
  }
</style>
