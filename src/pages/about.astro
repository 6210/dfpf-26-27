---
import CvDownload from '../components/CvDownload.astro';
import PhysicsPlaceholder from '../components/PhysicsPlaceholder.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="About | Professional portfolio"
  description="A dedicated page for sharing professional background."
  sections={[
    { id: 'about', label: 'About' },
    { id: 'interactive', label: 'Interactive' },
  ]}
>
  <h1 id="about">About</h1>
  <p class="lead">
    I own the technical delivery and day-to-day operation of Powerfleet's marketing websites and digital
    demand-generation systems, from requirements and implementation through testing, release, monitoring, and
    documentation.
  </p>
  <CvDownload />
  <PhysicsPlaceholder id="interactive" label="About animation" />
</SiteLayout>
