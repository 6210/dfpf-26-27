---
import AreaIcon from '../components/AreaIcon.astro';
import CvDownload from '../components/CvDownload.astro';
import PhysicsPlaceholder from '../components/PhysicsPlaceholder.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatYearMonth, getRoles } from '../lib/content';

const roles = await getRoles();
---

<SiteLayout
  title="Experience | Professional portfolio"
  description="Roles, responsibilities, and the platforms used in each area of work."
  sections={[
    // Nav labels never name an employer: the current role is generic, past roles use their title.
    ...roles.map((role) => ({ id: `role-${role.id}`, label: role.data.end ? role.data.title : 'Current role' })),
    { id: 'interactive', label: 'Interactive' },
  ]}
>
  <h1>Experience</h1>
  <p class="lead">
    I take projects from requirements and implementation through testing, release, monitoring, and documentation.
  </p>
  <CvDownload />
  {
    roles.map((role) => (
      <article class="role" id={`role-${role.id}`}>
        <h2>{role.data.title}</h2>
        <p class="role-meta">
          {[role.data.department && `${role.data.department}, `, role.data.company]}
          {' · '}
          <time datetime={role.data.start}>{formatYearMonth(role.data.start)}</time>
          {' – '}
          {role.data.end ? <time datetime={role.data.end}>{formatYearMonth(role.data.end)}</time> : 'Present'}
        </p>
        {role.data.companyNote && <p class="role-meta">{role.data.companyNote}</p>}
        <p>{role.data.summary}</p>
        <ul class="areas">
          {role.data.areas.map((area) => (
            <li data-accent={area.accent} data-morph={area.accent} data-morph-label={area.title}>
              <h3>
                {area.accent && <AreaIcon accent={area.accent} />}
                {area.title}
              </h3>
              <p>{area.summary}</p>
              {area.platforms.length > 0 && (
                <p class="platforms">
                  <span>Platforms:</span> {area.platforms.join(', ')}
                </p>
              )}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
  <PhysicsPlaceholder id="interactive" label="Experience animation" />
</SiteLayout>

<style>
  .role-meta {
    margin-block: 0.25rem;
  }

  /* One column on phones, two on tablets and small laptops, three on 13-inch laptops and wider. */
  .areas {
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    list-style: none;
    padding: 0;
  }

  .areas li {
    border-inline-start: 0.375rem solid var(--color-accent);
    padding-inline-start: 0.75rem;
  }

  .areas h3 {
    align-items: center;
    display: flex;
    font-size: 1.05rem;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
  }

  .areas p {
    margin: 0.25rem 0;
  }

  .platforms span {
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .areas li {
      transition: border-color 1s ease;
    }
  }
</style>
