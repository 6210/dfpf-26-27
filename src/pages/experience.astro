---
import CvDownload from '../components/CvDownload.astro';
import PhysicsPlaceholder from '../components/PhysicsPlaceholder.astro';
import Recommendations from '../components/Recommendations.astro';
import RoleEntry from '../components/RoleEntry.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getRecommendations, getRoles } from '../lib/content';

const roles = await getRoles();
const currentRoles = roles.filter((role) => !role.data.end);
const earlierRoles = roles.filter((role) => role.data.end);
const hasRecommendations = (await getRecommendations()).length > 0;
---

<SiteLayout
  title="Experience | Professional portfolio"
  description="Roles, responsibilities, recommendations, and the platforms used in each area of work."
  sections={[
    // Nav labels never name an employer.
    ...currentRoles.map((role) => ({ id: `role-${role.id}`, label: 'Current role' })),
    ...(earlierRoles.length > 0 ? [{ id: 'earlier-roles', label: 'Earlier roles' }] : []),
    ...(hasRecommendations ? [{ id: 'recommendations', label: 'Recommendations' }] : []),
    { id: 'interactive', label: 'Interactive' },
  ]}
>
  <section>
    <h1>Experience</h1>
    <p class="lead">
      I take projects from requirements and implementation through testing, release, monitoring, and documentation.
    </p>
    <CvDownload />
  </section>
  {currentRoles.map((role) => <RoleEntry role={role} />)}
  {
    earlierRoles.length > 0 && (
      // No visible heading: each role has its own, and the label names the region for the on-page navigation.
      <section class="earlier-roles" id="earlier-roles" aria-label="Earlier roles">
        {earlierRoles.map((role) => (
          <RoleEntry role={role} />
        ))}
      </section>
    )
  }
  <Recommendations />
  <PhysicsPlaceholder id="interactive" label="Experience animation" />
</SiteLayout>

<style>
  .earlier-roles {
    gap: var(--section-space);
  }
</style>
