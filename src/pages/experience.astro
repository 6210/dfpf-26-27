---
import PhysicsPlaceholder from '../components/PhysicsPlaceholder.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

// Headings from README.MD Core Responsibilities; colours are drafts.
const responsibilities = [
  { accent: 'operations', title: 'Website and Platform Operations' },
  { accent: 'campaigns', title: 'Campaign Experiences and Lead Generation' },
  { accent: 'automation', title: 'Marketing Automation and Data Capture' },
  { accent: 'analytics', title: 'Analytics and Advertising Measurement' },
  { accent: 'seo', title: 'Regional Content, SEO, and Brand Transition' },
  { accent: 'documentation', title: 'Documentation and Operational Ownership' },
];
---

<SiteLayout
  title="Experience | Professional portfolio"
  description="A dedicated page for sharing professional experience."
>
  <h1>Experience</h1>
  <p>Experience content is being prepared.</p>
  <h2>Core responsibilities</h2>
  <ul class="responsibilities">
    {
      responsibilities.map(({ accent, title }) => (
        <li data-accent={accent}>{title}</li>
      ))
    }
  </ul>
  <PhysicsPlaceholder label="Experience animation" />
</SiteLayout>

<style>
  .responsibilities {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .responsibilities li {
    border-inline-start: 0.375rem solid var(--color-accent);
    padding: 0.25rem 0 0.25rem 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .responsibilities li {
      transition: border-color 0.5s ease;
    }
  }
</style>
