---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader, { type Section } from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  canonical?: boolean;
  /** Sections of the page, in order, for the header's on-page navigation. Each id must exist on the page. */
  sections?: Section[];
}

const { title, description, canonical = true, sections = [] } = Astro.props;

if (!Astro.site) {
  throw new Error('Configure the production site URL in astro.config.mjs.');
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <script is:inline>
      (() => {
        const key = 'theme';
        const media = matchMedia('(prefers-color-scheme: dark)');
        let unsavedTheme = null;
        const stored = () => {
          try {
            const value = localStorage.getItem(key);
            return value === 'light' || value === 'dark' ? value : null;
          } catch {
            return null;
          }
        };
        const current = () => unsavedTheme ?? stored() ?? (media.matches ? 'dark' : 'light');
        const apply = () => {
          document.documentElement.dataset.theme = current();
        };

        apply();
        document.addEventListener('astro:after-swap', apply);
        media.addEventListener('change', apply);
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) {
            return;
          }
          const next = current() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(key, next);
          } catch {
            unsavedTheme = next;
          }
          apply();
        });
      })();
    </script>
    <Font cssVariable="--font-heading" preload />
    <ClientRouter />
  </head>
  <body>
    <SiteHeader sections={sections} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
    --color-background: light-dark(#ffffff, #121212);
    --color-text: light-dark(#1a1a1a, #ececec);
    --color-link: light-dark(#0b57d0, #8ab4f8);
    /* Draft accents for the Core Responsibilities sections; see README. */
    --color-accent-operations: light-dark(#1d4ed8, #93c5fd);
    --color-accent-campaigns: light-dark(#c2410c, #fdba74);
    --color-accent-automation: light-dark(#0f766e, #5eead4);
    --color-accent-analytics: light-dark(#7e22ce, #d8b4fe);
    --color-accent-seo: light-dark(#15803d, #86efac);
    --color-accent-documentation: light-dark(#a16207, #fde047);
    --color-accent: currentColor;
    /* All six accents as one blend: the site's signature, used for the name and the current-section marker. */
    --gradient-accents: linear-gradient(
      90deg,
      var(--color-accent-operations),
      var(--color-accent-automation),
      var(--color-accent-seo),
      var(--color-accent-documentation),
      var(--color-accent-campaigns),
      var(--color-accent-analytics)
    );
    /* Keeps in-page link targets clear of the sticky header. */
    scroll-padding-top: 6rem;
  }

  [data-accent='operations'] { --color-accent: var(--color-accent-operations); }
  [data-accent='campaigns'] { --color-accent: var(--color-accent-campaigns); }
  [data-accent='automation'] { --color-accent: var(--color-accent-automation); }
  [data-accent='analytics'] { --color-accent: var(--color-accent-analytics); }
  [data-accent='seo'] { --color-accent: var(--color-accent-seo); }
  [data-accent='documentation'] { --color-accent: var(--color-accent-documentation); }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
  }

  body {
    background: var(--color-background);
    box-sizing: border-box;
    color: var(--color-text);
    margin: 0 auto;
    max-width: 60rem;
    padding: 1.5rem;
  }

  a {
    color: var(--color-link);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 700;
  }

  /*
   * Design values: 70px size, 72px line height, -2px letter spacing. The size
   * scales from about 45px at 360px wide to 70px (4.375rem) at 1024px and
   * wider; line height and spacing keep the same proportions at every size.
   */
  h1 {
    font-size: clamp(2.5rem, 1.946rem + 3.795vw, 4.375rem);
    letter-spacing: calc(-2em / 70);
    line-height: calc(72 / 70);
    overflow-wrap: break-word;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  button {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0.25rem;
    color: inherit;
    font: inherit;
    padding: 0.25rem 0.75rem;
  }

  nav [aria-current='page'] {
    color: inherit;
    font-weight: 700;
  }

  /*
   * The head script sets data-theme before the page renders. Without JavaScript
   * the toggle cannot work, so it is not shown. Each label is shown only in the
   * theme it switches away from.
   */
  :root:not([data-theme]) [data-theme-toggle],
  :root:not([data-theme='light']) [data-theme-label='light'],
  :root:not([data-theme='dark']) [data-theme-label='dark'] {
    display: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    body,
    a,
    button {
      transition:
        background-color 0.5s ease,
        border-color 0.5s ease,
        color 0.5s ease;
    }
  }
</style>
