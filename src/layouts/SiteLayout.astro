---
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description: string;
  canonical?: boolean;
}

const { title, description, canonical = true } = Astro.props;

if (!Astro.site) {
  throw new Error('Configure the production site URL in astro.config.mjs.');
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <script is:inline>
      (() => {
        const key = 'theme';
        const media = matchMedia('(prefers-color-scheme: dark)');
        let unsavedTheme = null;
        const stored = () => {
          try {
            const value = localStorage.getItem(key);
            return value === 'light' || value === 'dark' ? value : null;
          } catch {
            return null;
          }
        };
        const current = () => unsavedTheme ?? stored() ?? (media.matches ? 'dark' : 'light');
        const apply = () => {
          document.documentElement.dataset.theme = current();
        };

        apply();
        document.addEventListener('astro:after-swap', apply);
        media.addEventListener('change', apply);
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) {
            return;
          }
          const next = current() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(key, next);
          } catch {
            unsavedTheme = next;
          }
          apply();
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <header>
      <SiteNav label="Main navigation" />
      <button type="button" data-theme-toggle>
        <span data-theme-label="light">Dark mode</span>
        <span data-theme-label="dark">Light mode</span>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
    --color-background: light-dark(#ffffff, #121212);
    --color-text: light-dark(#1a1a1a, #ececec);
    --color-link: light-dark(#0b57d0, #8ab4f8);
  }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
  }

  body {
    background: var(--color-background);
    box-sizing: border-box;
    color: var(--color-text);
    margin: 0 auto;
    max-width: 60rem;
    padding: 1.5rem;
  }

  a {
    color: var(--color-link);
  }

  header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  button {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0.25rem;
    color: inherit;
    font: inherit;
    padding: 0.25rem 0.75rem;
  }

  nav [aria-current='page'] {
    color: inherit;
    font-weight: 700;
  }

  /*
   * The head script sets data-theme before the page renders. Without JavaScript
   * the toggle cannot work, so it is not shown. Each label is shown only in the
   * theme it switches away from.
   */
  :root:not([data-theme]) [data-theme-toggle],
  :root:not([data-theme='light']) [data-theme-label='light'],
  :root:not([data-theme='dark']) [data-theme-label='dark'] {
    display: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    body,
    a,
    button {
      transition:
        background-color 0.5s ease,
        border-color 0.5s ease,
        color 0.5s ease;
    }
  }
</style>
