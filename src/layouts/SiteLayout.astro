---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  canonical?: boolean;
}

const { title, description, canonical = true } = Astro.props;

if (!Astro.site) {
  throw new Error('Configure the production site URL in astro.config.mjs.');
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <ClientRouter />
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
        <a
          href="/experience/"
          aria-current={Astro.url.pathname === '/experience/' ? 'page' : undefined}
        >Experience</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
  }

  body {
    box-sizing: border-box;
    margin: 0 auto;
    max-width: 60rem;
    padding: 1.5rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>
