---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import GetInTouch from '../components/GetInTouch.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AreaBadge from '../components/AreaBadge.astro';
import SiteHeader, { type Section } from '../components/SiteHeader.astro';
import type { TransitionDirectionalAnimations } from 'astro';

interface Props {
  title: string;
  description: string;
  canonical?: boolean;
  /** Sections of the page, in order, for the header's on-page navigation. Each id must exist on the page. */
  sections?: Section[];
}

const { title, description, canonical = true, sections = [] } = Astro.props;

if (!Astro.site) {
  throw new Error('Configure the production site URL in astro.config.mjs.');
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// The old page accelerates away and the next one snaps in and settles; Back reverses the direction.
const exit = (name: string) => ({
  name,
  duration: '0.3s',
  easing: 'cubic-bezier(0.55, 0, 1, 0.45)',
  fillMode: 'both',
});
const enter = (name: string) => ({
  name,
  duration: '0.7s',
  delay: '0.15s',
  easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
  fillMode: 'both',
});
const pageFade: TransitionDirectionalAnimations = {
  forwards: {
    old: exit('page-fade-out-up'),
    new: enter('page-fade-in-up'),
  },
  backwards: {
    old: exit('page-fade-out-down'),
    new: enter('page-fade-in-down'),
  },
};
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <script is:inline>
      (() => {
        const key = 'theme';
        const media = matchMedia('(prefers-color-scheme: dark)');
        let unsavedTheme = null;
        const stored = () => {
          try {
            const value = localStorage.getItem(key);
            return value === 'light' || value === 'dark' ? value : null;
          } catch {
            return null;
          }
        };
        const current = () => unsavedTheme ?? stored() ?? (media.matches ? 'dark' : 'light');
        const apply = () => {
          document.documentElement.dataset.theme = current();
        };

        apply();
        document.addEventListener('astro:after-swap', apply);
        media.addEventListener('change', apply);
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) {
            return;
          }
          const next = current() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(key, next);
          } catch {
            unsavedTheme = next;
          }
          apply();
          showThemeStatus(next);
        });

        // Brief "Dark mode on" message (in the top layer, so it shows above the open menu) and a screen reader announcement.
        let hideTimer = 0;
        const showThemeStatus = (theme) => {
          const text = theme === 'dark' ? 'Dark mode on' : 'Light mode on';
          const announce = document.querySelector('[data-theme-announce]');
          if (announce) announce.textContent = text;
          const status = document.querySelector('[data-theme-status]');
          if (!status || !('showPopover' in status)) return;
          status.textContent = text;
          if (!status.matches(':popover-open')) status.showPopover();
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => status.hidePopover(), 2600);
        };
      })();
    </script>
    <Font cssVariable="--font-heading" preload />
    <ClientRouter />
  </head>
  <body>
    <div class="theme-status" data-theme-status popover="manual" aria-hidden="true"></div>
    <p class="theme-announce" role="status" data-theme-announce></p>
    <AreaBadge />
    <SiteHeader sections={sections.length > 0 ? [...sections, { id: 'contact', label: 'Contact' }] : sections} />
    <div class="page" transition:name="page" transition:animate={pageFade}>
      <main>
        <slot />
        <GetInTouch />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
    /*
     * Page layout. Content fills the screen up to --page-max (1600px), centred beyond that, with a
     * side margin that grows from 24px on phones to 80px on wide screens. Paragraphs stop at
     * --measure for comfortable reading; interactive pieces use the full width.
     */
    --page-max: 100rem;
    /* How long colours take to fade when the theme (or an area accent) changes. */
    --theme-fade: 1.5s;
    --gutter: clamp(1.5rem, 4vw, 5rem);
    --page-inset: max(var(--gutter), (100% - var(--page-max)) / 2);
    --measure: 70ch;
    /* Space between page sections, and between rows and columns in card grids. */
    --section-space: clamp(4rem, 12svh, 9rem);
    --row-gap: clamp(2rem, 3vw, 3rem);
    --column-gap: clamp(2rem, 4vw, 4.5rem);
    /* Room kept free on the right of the content from 1024px, for a future side element. */
    --aside-space: 0px;
    --color-background: light-dark(#ffffff, #121212);
    --color-text: light-dark(#1a1a1a, #ececec);
    /*
     * The one accent colour: Pantone 13-0647 TCX Illuminating. It is used as is in dark mode (13.9:1 on the
     * background). On white it is only 1.35:1, so light mode uses a darker shade of the same hue (4.7:1).
     */
    --color-accent-pantone: #f5df4d;
    --color-accent: light-dark(#84740b, var(--color-accent-pantone));
    --color-link: var(--color-accent);
    /* Keeps in-page link targets clear of the sticky header. */
    scroll-padding-top: 6rem;
  }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
  }

  body {
    background: var(--color-background);
    box-sizing: border-box;
    color: var(--color-text);
    margin: 0;
    padding-block: 1.5rem;
  }

  .page {
    padding-inline: var(--page-inset);
  }

  main p,
  main li {
    line-height: 1.6;
    max-inline-size: var(--measure);
  }

  @media (min-width: 64rem) {
    :root {
      --aside-space: 9.375rem;
    }

    main {
      padding-inline-end: var(--aside-space);
    }
  }

  /*
   * Every direct child of main is a page section: at least 80% of the screen tall, its content centred
   * vertically, with --section-space between sections. Pages wrap loose headings and text in a section.
   */
  main > :not(script, style, template) {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-block: 0;
    min-block-size: 80svh;
    padding-block: calc(var(--section-space) / 2);
  }

  /*
   * Scroll reveal: each part of a section slides up and fades in as it scrolls into view, driven by the
   * scroll position (CSS scroll-driven animations, no JavaScript). Parts that contain .reveal elements
   * (cards, role headings) stay still and those elements move instead. Sections themselves never move, so in-page links land exactly. Browsers without support, reduced
   * motion and print show everything in place.
   */
  @keyframes reveal {
    from {
      opacity: 0;
      translate: 0 3rem;
    }
  }

  @supports (animation-timeline: view()) {
    @media screen and (prefers-reduced-motion: no-preference) {
      main > * > :not(:has(.reveal)),
      .reveal {
        /* Longhands only: the minifier would otherwise fold view() into an "animation" shorthand that browsers reject. */
        animation-fill-mode: both;
        animation-name: reveal;
        animation-range: entry 0% entry 60%;
        animation-timeline: view();
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
      }
    }
  }

  a {
    color: var(--color-link);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.2;
  }

  /*
   * Design values: 70px size, 72px line height, -2px letter spacing from 1024px
   * wide. The size scales down to 28px at 360px wide; line height and spacing
   * keep the same proportions at every size.
   */
  h1 {
    font-size: clamp(1.75rem, 0.327rem + 6.325vw, 4.375rem);
    letter-spacing: calc(-2em / 70);
    line-height: calc(72 / 70);
    overflow-wrap: break-word;
  }

  /* Introductory paragraph under a heading. Design values: 22px size, 34px line height, weight 100; 18px on small screens. */
  .lead {
    font-size: 1.375rem;
    font-weight: 100;
    line-height: calc(34 / 22);
  }

  /* Hairline text washes out on small light screens, so it is a little heavier there. */
  @media (max-width: 48rem) {
    .lead {
      font-size: 1.125rem;
    }
    :root[data-theme='light'] .lead {
      font-weight: 300;
    }

    @media (prefers-color-scheme: light) {
      :root:not([data-theme]) .lead {
        font-weight: 300;
      }
    }
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  button {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0.25rem;
    color: inherit;
    font: inherit;
    padding: 0.25rem 0.75rem;
  }

  nav [aria-current='page'] {
    color: inherit;
    font-weight: 700;
  }

  /*
   * The head script sets data-theme before the page renders. Without JavaScript
   * the toggle cannot work, so it is not shown. Each label is shown only in the
   * theme it switches away from.
   */
  :root:not([data-theme]) [data-theme-toggle],
  :root:not([data-theme='light']) [data-theme-label='light'],
  :root:not([data-theme='dark']) [data-theme-label='dark'] {
    display: none;
  }

  .theme-announce {
    block-size: 1px;
    clip-path: inset(50%);
    inline-size: 1px;
    margin: 0;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }

  /* Confirmation after switching theme, just below the header on the right. */
  .theme-status {
    background: var(--color-text);
    border: 0;
    border-radius: 999px;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.2);
    color: var(--color-background);
    font-size: 0.9375rem;
    font-weight: 600;
    inset: 4.5rem var(--page-inset) auto auto;
    margin: 0;
    padding: 0.5rem 1rem;
    position: fixed;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-status {
      opacity: 0;
      transition:
        background-color var(--theme-fade) ease,
        color var(--theme-fade) ease,
        opacity 0.3s ease,
        translate 0.3s ease,
        display 0.3s allow-discrete,
        overlay 0.3s allow-discrete;
      translate: 0 -0.5rem;
    }

    .theme-status:popover-open {
      opacity: 1;
      translate: 0 0;

      @starting-style {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Native smooth scrolling for in-page links when scripts are off; the header script eases them otherwise. */
    :root {
      scroll-behavior: smooth;
    }

    body,
    a,
    button {
      transition:
        background-color var(--theme-fade) ease,
        border-color var(--theme-fade) ease,
        color var(--theme-fade) ease;
    }
  }

  /* Page-to-page fades; see pageFade above. The faded state is also blurred and slightly smaller. */
  @keyframes page-fade-out-up {
    to {
      filter: blur(20px);
      opacity: 0;
      scale: 0.94;
      translate: 0 -10rem;
    }
  }

  @keyframes page-fade-in-up {
    from {
      filter: blur(20px);
      opacity: 0;
      scale: 0.94;
      translate: 0 14rem;
    }
  }

  @keyframes page-fade-out-down {
    to {
      filter: blur(20px);
      opacity: 0;
      scale: 0.94;
      translate: 0 10rem;
    }
  }

  @keyframes page-fade-in-down {
    from {
      filter: blur(20px);
      opacity: 0;
      scale: 0.94;
      translate: 0 -14rem;
    }
  }

  /* New pages start at the top, so the slight scale grows from the visible edge. */
  ::view-transition-new(page) {
    transform-origin: 50% 0;
  }

  /* Pages swap instantly for visitors who prefer reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
