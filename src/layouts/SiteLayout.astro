---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  canonical?: boolean;
}

const { title, description, canonical = true } = Astro.props;

if (!Astro.site) {
  throw new Error('Configure the production site URL in astro.config.mjs.');
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <script is:inline>
      (() => {
        const key = 'theme';
        const media = matchMedia('(prefers-color-scheme: dark)');
        let unsavedTheme = null;
        const stored = () => {
          try {
            const value = localStorage.getItem(key);
            return value === 'light' || value === 'dark' ? value : null;
          } catch {
            return null;
          }
        };
        const current = () => unsavedTheme ?? stored() ?? (media.matches ? 'dark' : 'light');
        const apply = () => {
          const theme = current();
          document.documentElement.dataset.theme = theme;
          for (const button of document.querySelectorAll('[data-theme-toggle]')) {
            button.hidden = false;
            button.setAttribute('aria-pressed', String(theme === 'dark'));
          }
        };

        apply();
        document.addEventListener('DOMContentLoaded', apply);
        document.addEventListener('astro:after-swap', apply);
        media.addEventListener('change', apply);
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) {
            return;
          }
          const next = current() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(key, next);
          } catch {
            unsavedTheme = next;
          }
          apply();
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
        <a
          href="/experience/"
          aria-current={Astro.url.pathname === '/experience/' ? 'page' : undefined}
        >Experience</a>
      </nav>
      <button type="button" data-theme-toggle aria-pressed="false" hidden>Dark mode</button>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
    --color-background: light-dark(#ffffff, #121212);
    --color-text: light-dark(#1a1a1a, #ececec);
    --color-link: light-dark(#0b57d0, #8ab4f8);
  }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
  }

  body {
    background: var(--color-background);
    box-sizing: border-box;
    color: var(--color-text);
    margin: 0 auto;
    max-width: 60rem;
    padding: 1.5rem;
  }

  a {
    color: var(--color-link);
  }

  header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  button {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0.25rem;
    color: inherit;
    font: inherit;
    padding: 0.25rem 0.75rem;
  }

  button[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-background);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>
