---
import PhysicsPlaceholder from './PhysicsPlaceholder.astro';
import { heroGraph, neutralConnectionLimit } from '../lib/hero-graph';

interface Props {
  title: string;
  /** Smaller line shown above the title, inside the h1 so search engines read both as one heading. */
  eyebrow?: string;
  id?: string;
  /** Label for the animation shown beside the text; no animation when omitted. */
  animation?: string;
  scatter?: boolean;
}

const { title, eyebrow, id, animation, scatter = false } = Astro.props;
---

<section class="hero" id={id}>
  <div class="hero-text">
    <h1>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {eyebrow && ' '}
      <slot name="title">{title}</slot>
    </h1>
    <slot />
  </div>
  <slot name="animation">
    {animation && <PhysicsPlaceholder label={animation} />}
  </slot>
  {scatter && (
    <div class="hero-scatter" data-hero-scatter aria-hidden="true">
      <svg data-neutral-connections aria-hidden="true" focusable="false">
        {Array.from({ length: neutralConnectionLimit }, () => (
          <line x1="0" y1="0" x2="0" y2="0" opacity="0" />
        ))}
      </svg>
      {heroGraph.stars.map(({ x, y, size, opacity }) => (
        <span style={`left:${x}%;top:${y}%;--scatter-size:${size}px;opacity:${opacity}`} />
      ))}
    </div>
  )}
</section>

<style>
  /*
   * Text first; from 1024px the animation sits beside it on the right (text gets about 60% of the width),
   * both centred vertically. The animation box keeps a 4:3 shape at every size.
   */
  .hero {
    align-content: center;
    display: grid;
    gap: var(--row-gap) var(--column-gap);
    grid-template-columns: minmax(0, 1fr);
    isolation: isolate;
    justify-content: stretch;
    position: relative;
    --physics-height: auto;
    --physics-ratio: 4 / 3;
  }

  .hero::before,
  .hero-scatter {
    inset-inline: calc(-1 * var(--page-inset)) calc(-1 * (var(--page-inset) + var(--aside-space)));
    pointer-events: none;
    position: absolute;
  }

  .hero::before {
    background-color: var(--color-background);
    content: '';
    inset-block: -6rem 0;
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 98%), rgb(0 0 0 / 94%) 65%, transparent);
    z-index: -2;
  }

  .hero-scatter {
    animation: none;
    color: var(--color-text);
    inset-block: -6rem 0;
    z-index: -1;
  }

  .hero-scatter span {
    background: currentColor;
    border-radius: 50%;
    height: var(--scatter-size);
    position: absolute;
    translate: -50% -50%;
    visibility: hidden;
    width: var(--scatter-size);
  }

  .hero-scatter[data-ready] span {
    visibility: visible;
  }

  .hero-scatter svg {
    fill: none;
    height: 100%;
    inset: 0;
    position: absolute;
    stroke: currentColor;
    stroke-width: var(--node-line-width);
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero::before {
      transition: background-color var(--theme-fade) ease;
    }

    .hero-scatter {
      transition: color var(--theme-fade) ease;
    }
  }

  /*
   * Accent in dark mode; the text colour in light mode, where coral on white is too faint for small text.
   * Uses the body font: only the bold weight of the heading font is loaded.
   */
  .eyebrow {
    color: var(--color-link);
    display: block;
    font-family: system-ui, sans-serif;
    font-size: clamp(0.9375rem, 0.85rem + 0.35vw, 1.125rem);
    font-weight: 300;
    letter-spacing: 0.12em;
    line-height: 1.3;
    margin-block-end: clamp(1.25rem, 2vw, 2rem);
    text-transform: uppercase;
  }

  .hero-text > :first-child {
    margin-block-start: 0;
  }

  @media (min-width: 64rem) {
    .hero-scatter span {
      height: calc(var(--scatter-size) * 1.8);
      width: calc(var(--scatter-size) * 1.8);
    }

    .hero:has(> [data-physics], > [data-hero-graph]) {
      align-items: center;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
    }
  }
</style>
