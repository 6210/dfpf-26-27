---
// Floating badge that shows the area of work in view. Its icon morphs (flubber) between areas as the visitor
// scrolls, hovers an area, or moves between pages, so Experience areas and Skills platforms share one visual.
// Targets are any elements in <main> with data-morph="<accent>" and data-morph-label="<area title>".
---

<div class="area-badge" data-area-badge hidden aria-hidden="true" transition:persist="area-badge">
  <span class="label" data-area-badge-label></span>
  <span class="disc">
    <svg viewBox="0 0 256 256" focusable="false">
      <path data-area-badge-path fill="currentColor" fill-rule="evenodd"></path>
    </svg>
  </span>
</div>

<script>
  import { areaIcons, isAccent, type Accent } from '../lib/area-icons';

  type Flubber = typeof import('flubber');

  const duration = 700;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let flubber: Promise<Flubber> | undefined;
  let shown: string[] = [];
  let current: Accent | undefined;
  let frame = 0;
  let queued = false;
  let targets: HTMLElement[] = [];
  let hovered: HTMLElement | undefined;

  const badge = () => document.querySelector<HTMLElement>('[data-area-badge]');

  // Loaded on the first animated morph only, so it is not part of the initial page load.
  const loadFlubber = () =>
    (flubber ??= import('flubber').then((module) => ((module as { default?: Flubber }).default ?? module) as Flubber));

  function draw(path: SVGPathElement, parts: string[]) {
    shown = parts;
    path.setAttribute('d', parts.join(''));
  }

  const ease = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);

  async function morphTo(el: HTMLElement, accent: Accent, path: SVGPathElement) {
    el.dataset.accent = accent;
    if (accent === current) return;
    current = accent;
    cancelAnimationFrame(frame);
    const to = areaIcons[accent].parts;
    if (shown.length === 0 || reduceMotion.matches) return draw(path, to);

    const { interpolate, toCircle, fromCircle } = await loadFlubber();
    if (current !== accent) return;
    const options = { maxSegmentLength: 6 };
    // Pair subpaths largest first; extra holes or details shrink to, or grow from, the centre.
    const steps = Array.from({ length: Math.max(shown.length, to.length) }, (_, i) => {
      const from = shown[i];
      const into = to[i];
      if (from && into) return interpolate(from, into, options);
      if (from) return toCircle(from, 128, 128, 1, options);
      return fromCircle(128, 128, 1, into, options);
    });
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      if (t === 1) return draw(path, to);
      draw(path, steps.map((step) => step(ease(t))));
      frame = requestAnimationFrame(tick);
    };
    frame = requestAnimationFrame(tick);
  }

  // The hovered target, or the one closest to a line just above the middle of the viewport.
  function pick() {
    if (hovered) return hovered;
    const line = innerHeight * 0.45;
    let best: HTMLElement | undefined;
    let bestDistance = Infinity;
    for (const target of targets) {
      const { top, bottom } = target.getBoundingClientRect();
      const distance = top > line ? top - line : bottom < line ? line - bottom : 0;
      if (distance < bestDistance) {
        best = target;
        bestDistance = distance;
      }
    }
    return best;
  }

  function update() {
    queued = false;
    const el = badge();
    const path = el?.querySelector<SVGPathElement>('[data-area-badge-path]');
    const label = el?.querySelector('[data-area-badge-label]');
    if (!el || !path || !label) return;
    const target = pick();
    const accent = target?.dataset.morph;
    el.classList.toggle('is-visible', Boolean(target));
    if (!target || !isAccent(accent)) return;
    label.textContent = target.dataset.morphLabel ?? '';
    void morphTo(el, accent, path);
  }

  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };

  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule);

  document.addEventListener('astro:page-load', () => {
    badge()?.removeAttribute('hidden');
    hovered = undefined;
    targets = [...document.querySelectorAll<HTMLElement>('main [data-morph]')];
    for (const target of targets) {
      target.addEventListener('pointerenter', () => {
        hovered = target;
        schedule();
      });
      target.addEventListener('pointerleave', () => {
        if (hovered === target) hovered = undefined;
        schedule();
      });
    }
    schedule();
  });
</script>

<style>
  .area-badge {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    inset-inline-end: var(--page-inset);
    opacity: 0;
    pointer-events: none;
    position: fixed;
    translate: 0 1rem;
    z-index: 5;
  }

  .area-badge[hidden] {
    display: none;
  }

  .area-badge.is-visible {
    opacity: 1;
    translate: 0 0;
  }

  .disc {
    background: var(--color-background);
    block-size: 3.5rem;
    border: 0.1875rem solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.15);
    color: var(--color-accent);
    display: grid;
    inline-size: 3.5rem;
    place-items: center;
  }

  .disc svg {
    block-size: 1.875rem;
    inline-size: 1.875rem;
  }

  .label {
    background: var(--color-background);
    border-radius: 999px;
    box-shadow: 0 0.25rem 1rem rgb(0 0 0 / 0.12);
    display: none;
    font-size: 0.875rem;
    font-weight: 600;
    max-inline-size: 22rem;
    padding: 0.375rem 0.875rem;
  }

  @media (width >= 48rem) {
    .label {
      display: block;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .area-badge {
      transition:
        opacity 0.4s ease,
        translate 0.4s ease;
    }

    .disc {
      transition:
        border-color var(--theme-fade) ease,
        color var(--theme-fade) ease,
        background-color var(--theme-fade) ease;
    }
  }
</style>
