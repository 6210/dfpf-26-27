---
import { getProfile } from '../lib/content';
import SiteNav from './SiteNav.astro';
import ThemeToggle from './ThemeToggle.astro';

export interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const { name } = await getProfile();
const isHome = Astro.url.pathname === '/';
---

<header class="site-header" data-site-header transition:name="site-header" transition:animate="none">
  {
    isHome ? (
      <span class="site-name">{name}</span>
    ) : (
      <a class="site-name" href="/">{name}</a>
    )
  }

  {
    sections.length > 0 && (
      <nav class="spy" aria-label="On this page" data-spy>
        {sections.map(({ id, label }) => (
          <a href={`#${id}`}>{label}</a>
        ))}
        <span class="spy-indicator" aria-hidden="true" data-spy-indicator />
      </nav>
    )
  }

  <div class="actions">
    <!-- Desktop: next to the menu button. Small screens use the copy inside the menu instead. -->
    <ThemeToggle id="header-theme" class="header-theme" />
    <!-- The Popover API opens and closes the menu without JavaScript, including with Escape. -->
    <button type="button" class="menu-button" popovertarget="site-menu">
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>

  <div id="site-menu" class="site-menu" popover>
    <!-- The full-screen menu covers the menu button, so it has its own close button in the same place. -->
    <button type="button" class="menu-button menu-close" popovertarget="site-menu" popovertargetaction="hide">
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">Close menu</span>
    </button>
    <SiteNav label="Main navigation" />
    <!-- Small screens only: the header has no room for the theme toggle, so it sits below the links. -->
    <ThemeToggle id="menu-theme" class="menu-theme" showLabel />
  </div>

  <span class="progress" aria-hidden="true" data-progress></span>
</header>

{
  /* Large screens with a mouse or trackpad: the on-page links move to a rail fixed on the right. It sits outside
     the header because the header slides away with a transform, which would carry a fixed child with it. */
  sections.length > 0 && (
    <nav class="rail" aria-label="On this page" data-spy data-rail>
      {sections.map(({ id, label }) => (
        <a href={`#${id}`}>
          <span class="rail-label">{label}</span>
          <span class="rail-mark" aria-hidden="true" />
        </a>
      ))}
    </nav>
  )
}

<style>
  .site-header {
    align-items: center;
    background: var(--color-background);
    column-gap: 1rem;
    display: grid;
    grid-template-areas: 'name actions' 'spy spy';
    grid-template-columns: 1fr auto;
    inset-block-start: 0;
    padding: 0.75rem var(--page-inset);
    position: sticky;
    row-gap: 0.5rem;
    z-index: 10;
  }

  /* Wide enough for the page sections to sit centred between the name and the controls. */
  @media (min-width: 48rem) {
    .site-header {
      grid-template-areas: 'name spy actions';
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  .site-name {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    grid-area: name;
    justify-self: start;
    letter-spacing: calc(-2em / 70);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .spy {
    flex-wrap: nowrap;
    grid-area: spy;
    justify-self: center;
    max-width: 100%;
    overflow-x: auto;
    position: relative;
    scrollbar-width: none;
  }

  .spy a {
    /* Muted, not hidden: about 6.4:1 contrast in light mode and 8.6:1 in dark. */
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-background));
    padding-block: 0.25rem;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Colour rather than weight marks the current link, so neighbouring links never shift. */
  .spy a:hover,
  .spy [aria-current='location'] {
    color: var(--color-text);
  }

  .spy-indicator {
    background: var(--color-accent);
    block-size: 2px;
    inline-size: var(--indicator-width, 0);
    inset: auto auto 0 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: translateX(var(--indicator-x, 0));
  }

  .spy-indicator[data-ready] {
    opacity: 1;
  }

  /* Only one of the two on-page navs is ever shown, so screen readers meet just one. */
  .rail {
    display: none;
  }

  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
    .spy {
      display: none;
    }

    .rail {
      align-items: flex-end;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      inset-block-start: 50%;
      inset-inline-end: 0;
      position: fixed;
      translate: 0 -50%;
      z-index: 9;
    }
  }

  .rail a {
    align-items: center;
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-background));
    display: flex;
    min-block-size: 1.75rem;
    padding-inline-start: 0.5rem;
    position: relative;
    text-decoration: none;
  }

  /* Hidden labels stay in the accessibility tree, so every link keeps its name. */
  .rail-label {
    font-size: 0.9375rem;
    inset-inline-end: calc(100% + 0.25rem);
    opacity: 0;
    pointer-events: none;
    position: absolute;
    translate: 1.5rem 0;
    white-space: nowrap;
  }

  /* A dot on a line running to the edge of the screen; the line grows for the current section. */
  .rail-mark {
    background: currentColor;
    block-size: 1px;
    inline-size: 1.25rem;
    position: relative;
  }

  .rail-mark::before {
    background: currentColor;
    block-size: 0.4375rem;
    border-radius: 50%;
    content: '';
    inset: 50% auto auto 0;
    inline-size: 0.4375rem;
    position: absolute;
    translate: -50% -50%;
  }

  .rail a:is(:hover, :focus-visible, [aria-current='location']) {
    color: var(--color-text);
  }

  .rail a:is(:hover, :focus-visible, [aria-current='location']) .rail-label {
    opacity: 1;
    pointer-events: auto;
    translate: 0 0;
  }

  /* Sized so the longest label still clears the content at 1024 px. */
  .rail [aria-current='location'] .rail-mark {
    inline-size: 3rem;
  }

  /* The current section's dot and line take the accent colour, like the header indicator. */
  .rail [aria-current='location'] .rail-mark {
    color: var(--color-accent);
  }

  .progress {
    background: var(--color-accent);
    block-size: 2px;
    inset: auto 0 0;
    pointer-events: none;
    position: absolute;
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  .actions {
    align-items: center;
    display: flex;
    gap: 0.5rem;
    grid-area: actions;
    justify-self: end;
    white-space: nowrap;
  }

  .menu-button {
    line-height: 0;
    padding: 0.5rem;
  }

  /* Icon-only next to the menu button, at the same height. */
  .actions :global(.header-theme) {
    line-height: 0;
    padding: 0.375rem 0.5rem;
  }

  .actions :global(.header-theme svg) {
    block-size: 1.125rem;
    inline-size: 1.125rem;
  }

  .menu-icon {
    display: grid;
    gap: 4px;
    inline-size: 1.25rem;
  }

  .menu-icon span {
    background: currentColor;
    block-size: 2px;
  }

  /* Full screen; the page shows faintly through a blur. */
  .site-menu {
    background: var(--color-background);
    block-size: auto;
    border: 0;
    color: var(--color-text);
    inline-size: auto;
    inset: 0;
    margin: 0;
    max-block-size: none;
    max-inline-size: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4.5rem 1.5rem;
  }

  .site-menu:popover-open {
    display: grid;
    place-items: center;
  }

  /*
   * A light veil keeps the page recognisable behind the menu. Light mode needs a thinner veil than dark,
   * because a white wash hides more. Opaque where blur is unsupported or less transparency is requested.
   */
  @supports (backdrop-filter: blur(1px)) {
    @media (prefers-reduced-transparency: no-preference) {
      .site-menu {
        --menu-blur: blur(12px);
        -webkit-backdrop-filter: var(--menu-blur);
        backdrop-filter: var(--menu-blur);
        background: light-dark(
          color-mix(in srgb, var(--color-background) 55%, transparent),
          color-mix(in srgb, var(--color-background) 65%, transparent)
        );
      }
    }
  }

  /* The page behind stays put while the menu is open. */
  :global(html:has(#site-menu:popover-open)) {
    overflow: hidden;
  }

  /* Just the X, tucked about 5px from the top-right corner; the padding keeps a comfortable tap target. */
  .menu-close {
    border: 0;
    inset: 1px 1px auto auto;
    padding: 4px;
    position: absolute;
  }

  .menu-close:focus-visible {
    outline-offset: -2px;
  }

  .site-menu:popover-open {
    align-content: center;
    gap: 2.5rem;
  }

  /* One theme toggle at a time: in the header above iPad width, in the menu on phones and tablets. */
  @media (width < 64rem) {
    .actions :global(.header-theme) {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .site-menu :global(.menu-theme) {
      display: none;
    }
  }

  .menu-close .menu-icon {
    block-size: 1.25rem;
    gap: 0;
    place-content: center;
  }

  .menu-close .menu-icon span {
    grid-area: 1 / 1;
    inline-size: 1.25rem;
    rotate: 45deg;
  }

  .menu-close .menu-icon span + span {
    rotate: -45deg;
  }

  .site-menu :global(nav) {
    align-items: center;
    flex-direction: column;
    gap: 1.25rem;
    text-align: center;
  }

  /* Same hover treatment as the on-page links: muted text brightens and a gradient underline grows. */
  .site-menu :global(nav a) {
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-background));
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 1.2rem + 2.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: calc(-2em / 70);
    line-height: 1.2;
    padding-block-end: 0.25rem;
    position: relative;
    text-decoration: none;
  }

  .site-menu :global(nav a::after) {
    background: var(--color-accent);
    block-size: 2px;
    content: '';
    inset: auto 0 0;
    position: absolute;
    scale: 0 1;
  }

  .site-menu :global(nav a:is(:hover, :focus-visible, [aria-current='page'])) {
    color: var(--color-text);
  }

  .site-menu :global(nav a:is(:hover, :focus-visible, [aria-current='page'])::after) {
    scale: 1 1;
  }

  .visually-hidden {
    block-size: 1px;
    clip-path: inset(50%);
    inline-size: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }

  @media (forced-colors: active) {
    .site-name {
      background: none;
      color: CanvasText;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        background-color var(--theme-fade) ease,
        transform 0.3s ease;
    }

    .spy a {
      transition: color 0.3s ease;
    }

    /* The line stretches out first and the label glides in behind it; leaving sections retract the same way. */
    .rail a {
      transition: color 0.4s ease;
    }

    .rail-mark {
      transition: inline-size 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .rail-label {
      transition:
        opacity 0.45s ease,
        translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .rail [aria-current='location'] .rail-label {
      transition-delay: 0.12s;
    }

    .site-menu :global(nav a::after) {
      transition: scale 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    }

    /* The veil fades in while the page behind softens into focus-blur; reversed on close. */
    .site-menu {
      opacity: 0;
      transition:
        backdrop-filter 0.9s ease,
        -webkit-backdrop-filter 0.9s ease,
        display 0.6s allow-discrete,
        opacity 0.6s ease,
        overlay 0.6s allow-discrete;
    }

    .site-menu:popover-open {
      opacity: 1;

      @starting-style {
        --menu-blur: blur(0);
        opacity: 0;
      }
    }

    /* Links rise into place one after another, and sink away together on close. */
    .site-menu :global(nav a) {
      filter: blur(4px);
      opacity: 0;
      transition:
        color 0.3s ease,
        filter 0.6s ease calc(var(--i, 0) * 100ms),
        opacity 0.6s ease calc(var(--i, 0) * 100ms),
        translate 0.9s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 100ms);
      translate: 0 2.5rem;
    }

    .site-menu:popover-open :global(nav a) {
      filter: none;
      opacity: 1;
      translate: 0 0;

      @starting-style {
        filter: blur(4px);
        opacity: 0;
        translate: 0 2.5rem;
      }
    }

    .site-menu :global(nav a:nth-child(2)) {
      --i: 1;
    }

    .site-menu :global(nav a:nth-child(3)) {
      --i: 2;
    }

    .site-menu :global(nav a:nth-child(4)) {
      --i: 3;
    }

    .site-menu :global(nav a:nth-child(5)) {
      --i: 4;
    }

    .site-menu :global(nav a:nth-child(n + 6)) {
      --i: 5;
    }

    /* The small-screen theme toggle arrives last, below the links. */
    .site-menu :global(.menu-theme) {
      filter: blur(4px);
      opacity: 0;
      transition:
        background-color var(--theme-fade) ease,
        border-color var(--theme-fade) ease,
        color var(--theme-fade) ease,
        filter 0.6s ease 0.5s,
        opacity 0.6s ease 0.5s,
        translate 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
      translate: 0 2.5rem;
    }

    .site-menu:popover-open :global(.menu-theme) {
      filter: none;
      opacity: 1;
      translate: 0 0;

      @starting-style {
        filter: blur(4px);
        opacity: 0;
        translate: 0 2.5rem;
      }
    }

    /* Glides between sections; the first placement happens before data-ready, so it does not slide in from the left. */
    .spy-indicator[data-ready] {
      transition:
        inline-size 0.45s cubic-bezier(0.65, 0, 0.35, 1),
        opacity 0.3s ease,
        transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    }
  }

  @media (forced-colors: active) {
    .rail-mark,
    .rail-mark::before,
    .spy-indicator,
    .progress,
    .site-menu :global(nav a::after) {
      background: Highlight;
    }

    .site-menu {
      background: Canvas;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  // Fired around eased in-page scrolls so the header and scroll spy can follow along.
  const scrollStart = 'site:smooth-scroll-start';
  const scrollEnd = 'site:smooth-scroll-end';
  // Any of these means the visitor has taken over scrolling.
  const userScrollEvents = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const cleanups: Array<() => void> = [];
  let cancelSmoothScroll: (() => void) | undefined;

  // Capture phase, so this runs before the client router handles the click.
  document.addEventListener('click', onAnchorClick, true);

  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (header) {
      cleanups.push(autoHide(header), readingProgress(header), fullScreenMenu(header));
    }
    for (const spy of document.querySelectorAll<HTMLElement>('[data-spy]')) {
      cleanups.push(scrollSpy(spy));
    }
  });

  document.addEventListener('astro:before-swap', () => {
    cancelSmoothScroll?.();
    for (const cleanup of cleanups.splice(0)) {
      cleanup();
    }
  });

  function onScrollFrame(callback: () => void): () => void {
    let queued = false;
    const listener = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          callback();
        });
      }
    };
    addEventListener('scroll', listener, { passive: true });
    addEventListener('resize', listener, { passive: true });
    callback();
    return () => {
      removeEventListener('scroll', listener);
      removeEventListener('resize', listener);
    };
  }

  function scrollOffset(): number {
    return parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
  }

  /** Turns same-page #links anywhere on the site into a gentle eased scroll. */
  function onAnchorClick(event: MouseEvent) {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return;
    }
    const link = (event.target as Element).closest('a[href]');
    if (!(link instanceof HTMLAnchorElement) || (link.target && link.target !== '_self') || link.hasAttribute('download')) {
      return;
    }
    const url = new URL(link.href);
    const samePage = url.origin === location.origin && url.pathname === location.pathname && url.search === location.search;
    const target = samePage && url.hash ? document.getElementById(decodeURIComponent(url.hash.slice(1))) : null;
    // Without a target, or with reduced motion, the client router jumps there as usual.
    if (!target || reducedMotion.matches) {
      return;
    }
    event.preventDefault();
    smoothScrollTo(target, url.href, link);
  }

  function smoothScrollTo(target: HTMLElement, href: string, link: HTMLAnchorElement) {
    cancelSmoothScroll?.();
    document.dispatchEvent(new CustomEvent(scrollStart, { detail: { id: target.id } }));

    // Let the client router record history and move focus exactly as for a normal click. It jumps to the
    // target synchronously, which gives the browser's own end position; return to the start before anything
    // is painted and glide there instead.
    const root = document.documentElement;
    const from = scrollY;
    root.style.scrollBehavior = 'auto';
    void navigate(href, { sourceElement: link });
    const to = scrollY;
    scrollTo({ top: from, behavior: 'instant' });
    root.style.scrollBehavior = '';

    const distance = to - from;
    // Longer trips take a little longer, but never so long that it feels sluggish.
    const duration = Math.min(1100, Math.max(450, 300 + Math.abs(distance) * 0.25));
    const ease = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
    let startTime: number | undefined;
    let frame = 0;

    const finish = (arrived: boolean) => {
      cancelAnimationFrame(frame);
      for (const type of userScrollEvents) {
        removeEventListener(type, interrupt);
      }
      cancelSmoothScroll = undefined;
      document.dispatchEvent(new CustomEvent(scrollEnd, { detail: { id: target.id, arrived } }));
    };
    const interrupt = () => finish(false);

    const step = (now: number) => {
      startTime ??= now;
      const progress = Math.min(1, (now - startTime) / duration);
      scrollTo({ top: from + distance * ease(progress), behavior: 'instant' });
      if (progress < 1) {
        frame = requestAnimationFrame(step);
      } else {
        finish(true);
      }
    };

    for (const type of userScrollEvents) {
      addEventListener(type, interrupt, { passive: true });
    }
    cancelSmoothScroll = interrupt;
    frame = requestAnimationFrame(step);
  }

  /** While the full-screen menu is open, keeps keyboard and screen reader focus out of the page behind it. */
  function fullScreenMenu(header: HTMLElement): () => void {
    const menu = header.querySelector<HTMLElement>('#site-menu');
    if (!menu) {
      return () => {};
    }
    const behind = () => [...header.children, document.querySelector('[data-rail]'), document.querySelector('main'), document.querySelector('footer')].filter((element): element is HTMLElement => element instanceof HTMLElement && element !== menu);

    const onBeforeToggle = (event: Event) => {
      // Released before closing, so the browser can return focus to the menu button.
      if ((event as ToggleEvent).newState === 'closed') {
        for (const element of behind()) {
          element.inert = false;
        }
      }
    };
    const onToggle = (event: Event) => {
      if ((event as ToggleEvent).newState === 'open') {
        for (const element of behind()) {
          element.inert = true;
        }
        menu.querySelector<HTMLElement>('.menu-close')?.focus();
      }
    };

    menu.addEventListener('beforetoggle', onBeforeToggle);
    menu.addEventListener('toggle', onToggle);
    return () => {
      menu.removeEventListener('beforetoggle', onBeforeToggle);
      menu.removeEventListener('toggle', onToggle);
    };
  }

  /** Hides the header while scrolling down and brings it back on any scroll up. */
  function autoHide(header: HTMLElement): () => void {
    const menu = header.querySelector<HTMLElement>('[popover]');
    const threshold = 8;
    let lastY = scrollY;
    let guided = false;

    const show = () => header.removeAttribute('data-hidden');
    // Keep the header in view during an eased scroll so the section indicator can be seen travelling.
    const onStart = () => {
      guided = true;
      show();
    };
    const onEnd = () => {
      guided = false;
      lastY = scrollY;
    };

    const stopScroll = onScrollFrame(() => {
      const y = scrollY;
      const delta = y - lastY;
      if (guided || Math.abs(delta) < threshold) {
        if (guided) lastY = y;
        return;
      }
      lastY = y;
      // Stay visible while it holds keyboard focus or the menu is open.
      const busy = header.contains(document.activeElement) || menu?.matches(':popover-open');
      if (delta > 0 && y > header.offsetHeight && !busy) {
        header.setAttribute('data-hidden', '');
      } else {
        show();
      }
    });

    header.addEventListener('focusin', show);
    document.addEventListener(scrollStart, onStart);
    document.addEventListener(scrollEnd, onEnd);
    return () => {
      stopScroll();
      header.removeEventListener('focusin', show);
      document.removeEventListener(scrollStart, onStart);
      document.removeEventListener(scrollEnd, onEnd);
    };
  }

  /** Fills the line along the bottom of the header as the visitor reads down the page. */
  function readingProgress(header: HTMLElement): () => void {
    return onScrollFrame(() => {
      const scrollable = document.documentElement.scrollHeight - innerHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, scrollY / scrollable)) : 0;
      header.style.setProperty('--progress', progress.toFixed(4));
    });
  }

  /** Marks the section currently being read as the current location in the on-page navigation. */
  function scrollSpy(nav: HTMLElement): () => void {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const ids = links.map((link) => decodeURIComponent(link.hash.slice(1)));
    const targets = ids.map((id) => document.getElementById(id));
    const indicator = nav.querySelector<HTMLElement>('[data-spy-indicator]');
    let current: HTMLAnchorElement | undefined;
    // After arriving at a section it stays current until the visitor scrolls, even if it cannot reach the top.
    let pinned: HTMLAnchorElement | undefined;

    const placeIndicator = () => {
      if (!indicator || !current) {
        return;
      }
      indicator.style.setProperty('--indicator-x', `${current.offsetLeft}px`);
      indicator.style.setProperty('--indicator-width', `${current.offsetWidth}px`);
      if (!indicator.hasAttribute('data-ready')) {
        // Show it only after the first placement has rendered, so it does not glide in from the edge.
        requestAnimationFrame(() => indicator.setAttribute('data-ready', ''));
      }
    };

    const mark = (next: HTMLAnchorElement) => {
      if (next === current) {
        return;
      }
      current?.removeAttribute('aria-current');
      next.setAttribute('aria-current', 'location');
      current = next;
      placeIndicator();

      // On narrow screens the links can overflow; keep the current one in view without scrolling the page.
      if (nav.scrollWidth > nav.clientWidth) {
        nav.scrollTo({
          left: next.offsetLeft - (nav.clientWidth - next.offsetWidth) / 2,
          behavior: reducedMotion.matches ? 'instant' : 'smooth',
        });
      }
    };

    const update = () => {
      if (pinned) {
        mark(pinned);
        return;
      }
      // A section becomes current once its top reaches the area just below the sticky header.
      const line = scrollOffset() + 16;
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      let index = 0;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top <= line) {
          index = i;
        }
      });
      mark(links[atBottom ? links.length - 1 : index]);
    };

    const pin = (id: string) => {
      const index = ids.indexOf(id);
      pinned = index === -1 ? undefined : links[index];
      update();
    };
    const onEnd = (event: Event) => {
      const { id, arrived } = (event as CustomEvent<{ id: string; arrived: boolean }>).detail;
      guided = false;
      if (arrived) {
        pin(id);
      }
    };
    // Covers jumps without the eased scroll, such as with reduced motion or Back and Forward.
    // During an eased scroll the indicator travels with the page instead and is pinned on arrival.
    let guided = false;
    const onStart = () => {
      guided = true;
      pinned = undefined;
    };
    const onHashChange = () => {
      if (!guided) {
        pin(decodeURIComponent(location.hash.slice(1)));
      }
    };
    const unpin = () => {
      pinned = undefined;
    };

    const resizer = new ResizeObserver(placeIndicator);
    resizer.observe(nav);
    document.addEventListener(scrollStart, onStart);
    document.addEventListener(scrollEnd, onEnd);
    addEventListener('hashchange', onHashChange);
    for (const type of userScrollEvents) {
      addEventListener(type, unpin, { passive: true });
    }
    const stopScroll = onScrollFrame(update);

    return () => {
      stopScroll();
      resizer.disconnect();
      document.removeEventListener(scrollStart, onStart);
      document.removeEventListener(scrollEnd, onEnd);
      removeEventListener('hashchange', onHashChange);
      for (const type of userScrollEvents) {
        removeEventListener(type, unpin);
      }
    };
  }
</script>
