---
import { getProfile } from '../lib/content';
import SiteNav from './SiteNav.astro';

export interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const { name } = await getProfile();
const isHome = Astro.url.pathname === '/';
---

<header class="site-header" data-site-header>
  {
    isHome ? (
      <span class="site-name">{name}</span>
    ) : (
      <a class="site-name" href="/">{name}</a>
    )
  }

  {
    sections.length > 0 && (
      <nav class="spy" aria-label="On this page" data-spy>
        {sections.map(({ id, label }) => (
          <a href={`#${id}`}>{label}</a>
        ))}
        <span class="spy-indicator" aria-hidden="true" data-spy-indicator />
      </nav>
    )
  }

  <div class="actions">
    <button type="button" data-theme-toggle>
      <span data-theme-label="light">Dark mode</span>
      <span data-theme-label="dark">Light mode</span>
    </button>
    <!-- The Popover API opens and closes the menu without JavaScript, including Escape and outside clicks. -->
    <button type="button" class="menu-button" popovertarget="site-menu">
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>

  <div id="site-menu" class="site-menu" popover>
    <SiteNav label="Main navigation" />
  </div>

  <span class="progress" aria-hidden="true" data-progress></span>
</header>

<style>
  .site-header {
    align-items: center;
    background: var(--color-background);
    column-gap: 1rem;
    display: grid;
    grid-template-areas: 'name actions' 'spy spy';
    grid-template-columns: 1fr auto;
    inset-block-start: 0;
    margin-inline: -1.5rem;
    padding: 0.75rem 1.5rem;
    position: sticky;
    row-gap: 0.5rem;
    z-index: 10;
  }

  /* Wide enough for the page sections to sit centred between the name and the controls. */
  @media (min-width: 48rem) {
    .site-header {
      grid-template-areas: 'name spy actions';
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  .site-name {
    background: var(--gradient-accents);
    background-clip: text;
    color: transparent;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    grid-area: name;
    justify-self: start;
    letter-spacing: calc(-2em / 70);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .spy {
    flex-wrap: nowrap;
    grid-area: spy;
    justify-self: center;
    max-width: 100%;
    overflow-x: auto;
    position: relative;
    scrollbar-width: none;
  }

  .spy a {
    /* Muted, not hidden: about 6.4:1 contrast in light mode and 8.6:1 in dark. */
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-background));
    padding-block: 0.25rem;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Colour rather than weight marks the current link, so neighbouring links never shift. */
  .spy a:hover,
  .spy [aria-current='location'] {
    color: var(--color-text);
  }

  .spy-indicator {
    background: var(--gradient-accents);
    block-size: 2px;
    inline-size: var(--indicator-width, 0);
    inset: auto auto 0 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: translateX(var(--indicator-x, 0));
  }

  .spy-indicator[data-ready] {
    opacity: 1;
  }

  .progress {
    background: var(--gradient-accents);
    block-size: 2px;
    inset: auto 0 0;
    pointer-events: none;
    position: absolute;
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  .actions {
    align-items: center;
    display: flex;
    gap: 0.5rem;
    grid-area: actions;
    justify-self: end;
    white-space: nowrap;
  }

  .menu-button {
    line-height: 0;
    padding: 0.5rem;
  }

  .menu-icon {
    display: grid;
    gap: 4px;
    inline-size: 1.25rem;
  }

  .menu-icon span {
    background: currentColor;
    block-size: 2px;
  }

  .site-menu {
    background: var(--color-background);
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    color: var(--color-text);
    inset: 4rem 1rem auto auto;
    margin: 0;
    padding: 1rem 1.5rem;
  }

  .site-menu :global(nav) {
    flex-direction: column;
  }

  .visually-hidden {
    block-size: 1px;
    clip-path: inset(50%);
    inline-size: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }

  @media (forced-colors: active) {
    .site-name {
      background: none;
      color: CanvasText;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        background-color 0.5s ease,
        transform 0.3s ease;
    }

    .spy a {
      transition: color 0.3s ease;
    }

    /* Glides between sections; the first placement happens before data-ready, so it does not slide in from the left. */
    .spy-indicator[data-ready] {
      transition:
        inline-size 0.45s cubic-bezier(0.65, 0, 0.35, 1),
        opacity 0.3s ease,
        transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    }
  }

  @media (forced-colors: active) {
    .spy-indicator,
    .progress {
      background: Highlight;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  // Fired around eased in-page scrolls so the header and scroll spy can follow along.
  const scrollStart = 'site:smooth-scroll-start';
  const scrollEnd = 'site:smooth-scroll-end';
  // Any of these means the visitor has taken over scrolling.
  const userScrollEvents = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const cleanups: Array<() => void> = [];
  let cancelSmoothScroll: (() => void) | undefined;

  // Capture phase, so this runs before the client router handles the click.
  document.addEventListener('click', onAnchorClick, true);

  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (header) {
      cleanups.push(autoHide(header), readingProgress(header));
    }
    const spy = document.querySelector<HTMLElement>('[data-spy]');
    if (spy) {
      cleanups.push(scrollSpy(spy));
    }
  });

  document.addEventListener('astro:before-swap', () => {
    cancelSmoothScroll?.();
    for (const cleanup of cleanups.splice(0)) {
      cleanup();
    }
  });

  function onScrollFrame(callback: () => void): () => void {
    let queued = false;
    const listener = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          callback();
        });
      }
    };
    addEventListener('scroll', listener, { passive: true });
    addEventListener('resize', listener, { passive: true });
    callback();
    return () => {
      removeEventListener('scroll', listener);
      removeEventListener('resize', listener);
    };
  }

  function scrollOffset(): number {
    return parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
  }

  /** Turns same-page #links anywhere on the site into a gentle eased scroll. */
  function onAnchorClick(event: MouseEvent) {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return;
    }
    const link = (event.target as Element).closest('a[href]');
    if (!(link instanceof HTMLAnchorElement) || (link.target && link.target !== '_self') || link.hasAttribute('download')) {
      return;
    }
    const url = new URL(link.href);
    const samePage = url.origin === location.origin && url.pathname === location.pathname && url.search === location.search;
    const target = samePage && url.hash ? document.getElementById(decodeURIComponent(url.hash.slice(1))) : null;
    // Without a target, or with reduced motion, the client router jumps there as usual.
    if (!target || reducedMotion.matches) {
      return;
    }
    event.preventDefault();
    smoothScrollTo(target, url.href, link);
  }

  function smoothScrollTo(target: HTMLElement, href: string, link: HTMLAnchorElement) {
    cancelSmoothScroll?.();
    document.dispatchEvent(new CustomEvent(scrollStart, { detail: { id: target.id } }));

    // Let the client router record history and move focus exactly as for a normal click. It jumps to the
    // target synchronously, which gives the browser's own end position; return to the start before anything
    // is painted and glide there instead.
    const root = document.documentElement;
    const from = scrollY;
    root.style.scrollBehavior = 'auto';
    void navigate(href, { sourceElement: link });
    const to = scrollY;
    scrollTo({ top: from, behavior: 'instant' });
    root.style.scrollBehavior = '';

    const distance = to - from;
    // Longer trips take a little longer, but never so long that it feels sluggish.
    const duration = Math.min(1100, Math.max(450, 300 + Math.abs(distance) * 0.25));
    const ease = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
    let startTime: number | undefined;
    let frame = 0;

    const finish = (arrived: boolean) => {
      cancelAnimationFrame(frame);
      for (const type of userScrollEvents) {
        removeEventListener(type, interrupt);
      }
      cancelSmoothScroll = undefined;
      document.dispatchEvent(new CustomEvent(scrollEnd, { detail: { id: target.id, arrived } }));
    };
    const interrupt = () => finish(false);

    const step = (now: number) => {
      startTime ??= now;
      const progress = Math.min(1, (now - startTime) / duration);
      scrollTo({ top: from + distance * ease(progress), behavior: 'instant' });
      if (progress < 1) {
        frame = requestAnimationFrame(step);
      } else {
        finish(true);
      }
    };

    for (const type of userScrollEvents) {
      addEventListener(type, interrupt, { passive: true });
    }
    cancelSmoothScroll = interrupt;
    frame = requestAnimationFrame(step);
  }

  /** Hides the header while scrolling down and brings it back on any scroll up. */
  function autoHide(header: HTMLElement): () => void {
    const menu = header.querySelector<HTMLElement>('[popover]');
    const threshold = 8;
    let lastY = scrollY;
    let guided = false;

    const show = () => header.removeAttribute('data-hidden');
    // Keep the header in view during an eased scroll so the section indicator can be seen travelling.
    const onStart = () => {
      guided = true;
      show();
    };
    const onEnd = () => {
      guided = false;
      lastY = scrollY;
    };

    const stopScroll = onScrollFrame(() => {
      const y = scrollY;
      const delta = y - lastY;
      if (guided || Math.abs(delta) < threshold) {
        if (guided) lastY = y;
        return;
      }
      lastY = y;
      // Stay visible while it holds keyboard focus or the menu is open.
      const busy = header.contains(document.activeElement) || menu?.matches(':popover-open');
      if (delta > 0 && y > header.offsetHeight && !busy) {
        header.setAttribute('data-hidden', '');
      } else {
        show();
      }
    });

    header.addEventListener('focusin', show);
    document.addEventListener(scrollStart, onStart);
    document.addEventListener(scrollEnd, onEnd);
    return () => {
      stopScroll();
      header.removeEventListener('focusin', show);
      document.removeEventListener(scrollStart, onStart);
      document.removeEventListener(scrollEnd, onEnd);
    };
  }

  /** Fills the line along the bottom of the header as the visitor reads down the page. */
  function readingProgress(header: HTMLElement): () => void {
    return onScrollFrame(() => {
      const scrollable = document.documentElement.scrollHeight - innerHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, scrollY / scrollable)) : 0;
      header.style.setProperty('--progress', progress.toFixed(4));
    });
  }

  /** Marks the section currently being read as the current location in the on-page navigation. */
  function scrollSpy(nav: HTMLElement): () => void {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const ids = links.map((link) => decodeURIComponent(link.hash.slice(1)));
    const targets = ids.map((id) => document.getElementById(id));
    const indicator = nav.querySelector<HTMLElement>('[data-spy-indicator]');
    let current: HTMLAnchorElement | undefined;
    // After arriving at a section it stays current until the visitor scrolls, even if it cannot reach the top.
    let pinned: HTMLAnchorElement | undefined;

    const placeIndicator = () => {
      if (!indicator || !current) {
        return;
      }
      indicator.style.setProperty('--indicator-x', `${current.offsetLeft}px`);
      indicator.style.setProperty('--indicator-width', `${current.offsetWidth}px`);
      if (!indicator.hasAttribute('data-ready')) {
        // Show it only after the first placement has rendered, so it does not glide in from the edge.
        requestAnimationFrame(() => indicator.setAttribute('data-ready', ''));
      }
    };

    const mark = (next: HTMLAnchorElement) => {
      if (next === current) {
        return;
      }
      current?.removeAttribute('aria-current');
      next.setAttribute('aria-current', 'location');
      current = next;
      placeIndicator();

      // On narrow screens the links can overflow; keep the current one in view without scrolling the page.
      if (nav.scrollWidth > nav.clientWidth) {
        nav.scrollTo({
          left: next.offsetLeft - (nav.clientWidth - next.offsetWidth) / 2,
          behavior: reducedMotion.matches ? 'instant' : 'smooth',
        });
      }
    };

    const update = () => {
      if (pinned) {
        mark(pinned);
        return;
      }
      // A section becomes current once its top reaches the area just below the sticky header.
      const line = scrollOffset() + 16;
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      let index = 0;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top <= line) {
          index = i;
        }
      });
      mark(links[atBottom ? links.length - 1 : index]);
    };

    const pin = (id: string) => {
      const index = ids.indexOf(id);
      pinned = index === -1 ? undefined : links[index];
      update();
    };
    const onEnd = (event: Event) => {
      const { id, arrived } = (event as CustomEvent<{ id: string; arrived: boolean }>).detail;
      guided = false;
      if (arrived) {
        pin(id);
      }
    };
    // Covers jumps without the eased scroll, such as with reduced motion or Back and Forward.
    // During an eased scroll the indicator travels with the page instead and is pinned on arrival.
    let guided = false;
    const onStart = () => {
      guided = true;
      pinned = undefined;
    };
    const onHashChange = () => {
      if (!guided) {
        pin(decodeURIComponent(location.hash.slice(1)));
      }
    };
    const unpin = () => {
      pinned = undefined;
    };

    const resizer = new ResizeObserver(placeIndicator);
    resizer.observe(nav);
    document.addEventListener(scrollStart, onStart);
    document.addEventListener(scrollEnd, onEnd);
    addEventListener('hashchange', onHashChange);
    for (const type of userScrollEvents) {
      addEventListener(type, unpin, { passive: true });
    }
    const stopScroll = onScrollFrame(update);

    return () => {
      stopScroll();
      resizer.disconnect();
      document.removeEventListener(scrollStart, onStart);
      document.removeEventListener(scrollEnd, onEnd);
      removeEventListener('hashchange', onHashChange);
      for (const type of userScrollEvents) {
        removeEventListener(type, unpin);
      }
    };
  }
</script>
