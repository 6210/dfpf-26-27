---
/*
 * The DF monogram, drawn in the current text colour so it follows the site's light and dark themes.
 * Decorative here: the link around it carries the name as text. public/favicon.svg holds the same shapes.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['logo-mark', className]} viewBox="0 0 100 100" fill="currentColor" aria-hidden="true" focusable="false">
  <path fill-rule="evenodd" d="M47 10V23L34 36V42H19L7 54V90H35L47 78V10ZM21 55H34V71L29 76H21ZM67 10 53 24V42H47V55H53V90L66 77V55H81L94 42H66V29L72 23H80L93 10Z"></path>
</svg>
