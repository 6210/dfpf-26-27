---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<figure class="physics" data-physics>
  <div class="physics-stage" data-physics-stage aria-hidden="true"></div>
  <figcaption>
    <span data-physics-status>{label} placeholder. Click or scroll to change the shapes.</span>
    <button type="button" data-physics-add>Add shapes</button>
  </figcaption>
</figure>

<style>
  .physics-stage {
    aspect-ratio: var(--physics-ratio, auto);
    border: 1px dashed currentColor;
    border-radius: 0.5rem;
    color: var(--color-accent);
    cursor: pointer;
    /* Taller on bigger screens, without pushing the caption off a short laptop screen. The hero uses a 4:3 shape instead. */
    height: var(--physics-height, clamp(16rem, 50svh, 40rem));
    overflow: hidden;
    touch-action: manipulation;
  }

  .physics-stage :global(canvas) {
    display: block;
  }

  .physics {
    margin: 0;
  }

  figcaption {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  /* Keep the button's space reserved so it does not shift the layout when shown. */
  [data-physics-add]:not([data-ready]) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .physics-stage {
      transition: color var(--theme-fade) ease, border-color var(--theme-fade) ease;
    }
  }
</style>

<script>
  import type MatterNamespace from 'matter-js';

  type Matter = typeof MatterNamespace;
  type Shape = 'circle' | 'square' | 'triangle';

  const shapes: Shape[] = ['circle', 'square', 'triangle'];
  const maxBodies = 40;
  const scrollDistancePerShape = 300;
  const cleanups: Array<() => void> = [];

  document.addEventListener('astro:page-load', () => {
    for (const figure of document.querySelectorAll<HTMLElement>('[data-physics]')) {
      cleanups.push(prepare(figure));
    }
  });

  document.addEventListener('astro:before-swap', () => {
    for (const cleanup of cleanups.splice(0)) {
      cleanup();
    }
  });

  function prepare(figure: HTMLElement): () => void {
    const stage = figure.querySelector<HTMLElement>('[data-physics-stage]');
    const status = figure.querySelector<HTMLElement>('[data-physics-status]');
    if (!stage || !status) {
      return () => {};
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      status.textContent = 'Animation paused because reduced motion is preferred.';
      return () => {};
    }

    let stop = () => {};
    let cancelled = false;

    // Load Matter.js only once the placeholder is about to be seen.
    const loader = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) {
          return;
        }
        loader.disconnect();
        const { default: Matter } = await import('matter-js');
        if (!cancelled) {
          stop = start(Matter, figure, stage);
        }
      },
      { rootMargin: '200px' },
    );
    loader.observe(stage);

    return () => {
      cancelled = true;
      loader.disconnect();
      stop();
    };
  }

  function start(Matter: Matter, figure: HTMLElement, stage: HTMLElement): () => void {
    const { Bodies, Body, Composite, Engine, Events, Render, Runner } = Matter;
    const engine = Engine.create();
    const runner = Runner.create();
    const render = Render.create({
      element: stage,
      engine,
      options: {
        width: stage.clientWidth,
        height: stage.clientHeight,
        background: 'transparent',
        wireframes: false,
        pixelRatio: devicePixelRatio,
      },
    });

    let shapeIndex = 0;
    let bodies: MatterNamespace.Body[] = [];
    let walls: MatterNamespace.Body[] = [];
    let scrolled = 0;
    let lastScrollY = scrollY;
    let running = false;

    const createBody = (x: number, y: number) => {
      const size = 12 + Math.random() * 10;
      const options = { restitution: 0.6, friction: 0.05 };
      switch (shapes[shapeIndex]) {
        case 'square':
          return Bodies.rectangle(x, y, size * 2, size * 2, options);
        case 'triangle':
          return Bodies.polygon(x, y, 3, size * 1.3, options);
        default:
          return Bodies.circle(x, y, size, options);
      }
    };

    const add = (newBodies: MatterNamespace.Body[]) => {
      bodies.push(...newBodies);
      Composite.add(engine.world, newBodies);
      const excess = bodies.splice(0, Math.max(0, bodies.length - maxBodies));
      Composite.remove(engine.world, excess);
    };

    const spawn = (x: number, y: number, count: number) => {
      add(Array.from({ length: count }, () => createBody(x + (Math.random() - 0.5) * 30, y)));
    };

    const nextShape = () => {
      shapeIndex = (shapeIndex + 1) % shapes.length;
    };

    const morphAll = () => {
      const replacements = bodies.map((body) => {
        const replacement = createBody(body.position.x, body.position.y);
        Body.setVelocity(replacement, body.velocity);
        return replacement;
      });
      Composite.remove(engine.world, bodies);
      bodies = [];
      add(replacements);
    };

    const buildWalls = (width: number, height: number) => {
      const thickness = 100;
      const options = { isStatic: true, render: { visible: false } };
      Composite.remove(engine.world, walls);
      walls = [
        Bodies.rectangle(width / 2, height + thickness / 2, width * 2, thickness, options),
        Bodies.rectangle(width / 2, -thickness / 2, width * 2, thickness, options),
        Bodies.rectangle(-thickness / 2, height / 2, thickness, height * 2, options),
        Bodies.rectangle(width + thickness / 2, height / 2, thickness, height * 2, options),
      ];
      Composite.add(engine.world, walls);
    };

    const onScrollDelta = (delta: number) => {
      const push = Math.max(-8, Math.min(8, delta / 15));
      for (const body of bodies) {
        Body.setVelocity(body, { x: body.velocity.x, y: body.velocity.y - push });
      }
      scrolled += Math.abs(delta);
      if (scrolled >= scrollDistancePerShape) {
        scrolled = 0;
        nextShape();
        morphAll();
      }
    };

    const onScroll = () => {
      onScrollDelta(scrollY - lastScrollY);
      lastScrollY = scrollY;
    };

    // Short pages cannot scroll, so wheel movement stands in for scrolling there.
    const onWheel = (event: WheelEvent) => {
      if (document.documentElement.scrollHeight <= innerHeight) {
        onScrollDelta(event.deltaY);
      }
    };

    const onClick = (event: MouseEvent) => {
      const rect = stage.getBoundingClientRect();
      nextShape();
      spawn(event.clientX - rect.left, event.clientY - rect.top, 3);
    };

    const addButton = figure.querySelector<HTMLButtonElement>('[data-physics-add]');
    const onAdd = () => {
      nextShape();
      spawn(Math.random() * stage.clientWidth, 30, 3);
    };

    const setRunning = (visible: boolean) => {
      if (visible === running) {
        return;
      }
      running = visible;
      if (visible) {
        Runner.run(runner, engine);
        Render.run(render);
      } else {
        Runner.stop(runner);
        Render.stop(render);
      }
    };

    // Shapes use the stage's text color so they follow the theme and its fade.
    Events.on(render, 'beforeRender', () => {
      const color = getComputedStyle(stage).color;
      for (const body of bodies) {
        body.render.fillStyle = color;
      }
    });

    const resizer = new ResizeObserver(() => {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      Render.setSize(render, width, height);
      buildWalls(width, height);
      for (const body of bodies) {
        Body.setPosition(body, {
          x: Math.min(Math.max(body.position.x, 20), width - 20),
          y: Math.min(Math.max(body.position.y, 20), height - 20),
        });
      }
    });

    const visibility = new IntersectionObserver((entries) => {
      setRunning(entries.some((entry) => entry.isIntersecting));
    });

    buildWalls(stage.clientWidth, stage.clientHeight);
    for (let i = 0; i < 12; i++) {
      spawn(Math.random() * stage.clientWidth, 30 + Math.random() * 60, 1);
    }

    stage.addEventListener('click', onClick);
    addButton?.addEventListener('click', onAdd);
    addButton?.setAttribute('data-ready', '');
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('wheel', onWheel, { passive: true });
    resizer.observe(stage);
    visibility.observe(stage);

    return () => {
      setRunning(false);
      resizer.disconnect();
      visibility.disconnect();
      stage.removeEventListener('click', onClick);
      addButton?.removeEventListener('click', onAdd);
      removeEventListener('scroll', onScroll);
      removeEventListener('wheel', onWheel);
      Composite.clear(engine.world, false);
      Engine.clear(engine);
      render.canvas.remove();
    };
  }
</script>
