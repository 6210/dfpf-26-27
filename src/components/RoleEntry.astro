---
import type { Role } from '../lib/content';
import { formatYearMonth } from '../lib/content';
import AreaIcon from './AreaIcon.astro';

interface Props {
  role: Role;
  /** 2 for the current role; 3 for roles listed under "Earlier roles". */
  level?: 2 | 3;
}

const { role, level = 2 } = Astro.props;
const { title, department, company, companyNote, start, end, summary, areas } = role.data;
const Heading = `h${level}` as 'h2' | 'h3';
const AreaHeading = `h${level + 1}` as 'h3' | 'h4';
---

<article class="role" id={`role-${role.id}`}>
  <Heading>{title}</Heading>
  <p class="role-meta">
    {[department && `${department}, `, company]}
    {' · '}
    <time datetime={start}>{formatYearMonth(start)}</time>
    {' – '}
    {end ? <time datetime={end}>{formatYearMonth(end)}</time> : 'Present'}
  </p>
  {companyNote && <p class="role-meta">{companyNote}</p>}
  <p>{summary}</p>
  {
    areas.length > 0 && (
      <ul class="areas">
        {areas.map((area) => (
          <li data-accent={area.accent} data-morph={area.accent} data-morph-label={area.title}>
            <AreaHeading>
              {area.accent && <AreaIcon accent={area.accent} />}
              {area.title}
            </AreaHeading>
            <p>{area.summary}</p>
            {area.platforms.length > 0 && (
              <p class="platforms">
                <span>Platforms:</span> {area.platforms.join(', ')}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .role-meta {
    margin-block: 0.25rem;
  }

  /* One column on phones, two on tablets and small laptops, three on 13-inch laptops and wider. */
  .areas {
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    list-style: none;
    padding: 0;
  }

  .areas li {
    border-inline-start: 0.375rem solid var(--color-accent);
    padding-inline-start: 0.75rem;
  }

  .areas :is(h3, h4) {
    align-items: center;
    display: flex;
    font-size: 1.05rem;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
  }

  .areas p {
    margin: 0.25rem 0;
  }

  .platforms span {
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .areas li {
      transition: border-color var(--theme-fade) ease;
    }
  }
</style>
