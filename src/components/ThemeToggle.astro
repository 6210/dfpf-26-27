---
/*
 * Theme toggle icon adapted from the "Spin" toggle by Alfie Jones (https://toggles.dev, MIT), drawn as outlines.
 * Light theme: a sun with eight rays. Dark theme: the rays spin away while the sun grows and a clip-path bite
 * slides in, leaving a crescent moon; a second circle, kept inside the moon, draws the bite's inner edge.
 * The head script's click handler for [data-theme-toggle] does the switching; this component only draws the
 * button, and its CSS follows :root[data-theme].
 */
interface Props {
  /** Unique per page, so each SVG clip-path has its own id. */
  id: string;
  class?: string;
  /** Show the "Switch to dark/light mode" text next to the icon; otherwise it appears as a hint on hover and focus. */
  showLabel?: boolean;
}

const { id, class: className, showLabel = false } = Astro.props;
const biteId = `${id}-bite`;
const coreId = `${id}-core`;
const rays = [
  'M12 1.4v2.4',
  'm20.3 3.7-2.5 2.5',
  'M22.6 12h-2.4',
  'M12 22.6v-2.4',
  'M1.4 12h2.4',
  'm20.3 20.3-2.5-2.5',
  'm3.7 20.3 2.5-2.5',
  'm3.7 3.7 2.5 2.5',
];
---

<button type="button" class:list={['theme-toggle', className]} data-theme-toggle>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <clipPath id={biteId}>
      <path class="bite" d="M0 0h25a1 1 0 0010 10v14H0Z"></path>
    </clipPath>
    <clipPath id={coreId}>
      <circle class="core" cx="12" cy="12" r="5"></circle>
    </clipPath>
    <circle class="core" cx="12" cy="12" r="5" clip-path={`url(#${biteId})`}></circle>
    <g clip-path={`url(#${coreId})`}>
      <circle class="bite-edge" cx="30" cy="5" r="7.07"></circle>
    </g>
    {rays.map((d) => <path class="ray" d={d}></path>)}
  </svg>
  <span class:list={['theme-toggle-label', { 'theme-toggle-hint': !showLabel }]}>
    <span data-theme-label="light">Switch to dark mode</span>
    <span data-theme-label="dark">Switch to light mode</span>
  </span>
</button>

<style>
  .theme-toggle {
    align-items: center;
    border: 0;
    display: inline-flex;
    padding: 0;
    gap: 0.5rem;
    line-height: 1.2;
  }

  svg {
    block-size: 1.25rem;
    flex: none;
    inline-size: 1.25rem;
    overflow: visible;
  }

  /* Keeps the sun's outline the same width as the rays while it grows into the moon. */
  .core,
  .bite-edge {
    stroke-width: 1.67px;
    transform-origin: 12px 12px;
    vector-effect: non-scaling-stroke;
  }

  .ray {
    transform-origin: 12px 12px;
  }

  :root[data-theme='dark'] .core {
    scale: 1.7;
  }

  /* The bite (and its drawn edge) moves in from the top right. */
  :root[data-theme='dark'] .bite {
    d: path('M0 2h13a1 1 0 0010 10v14H0Z');
  }

  :root[data-theme='dark'] .bite-edge {
    translate: -12px 2px;
  }

  @supports not (d: path('M0 0')) {
    :root[data-theme='dark'] .bite {
      translate: -12px 2px;
    }
  }

  :root[data-theme='dark'] .ray {
    rotate: 45deg;
    scale: 0;
  }

  /* Rays spin out first going dark and back in last going light; the bite follows the sun. */
  @media (prefers-reduced-motion: no-preference) {
    .core,
    .bite,
    .bite-edge,
    .ray {
      transition:
        d 0.6s cubic-bezier(0.34, 1.3, 0.64, 1),
        rotate 0.6s ease,
        scale 0.6s cubic-bezier(0.34, 1.3, 0.64, 1),
        translate 0.6s cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    .ray {
      transition-delay: 0.1s;
    }

    :root[data-theme='dark'] :is(.bite, .bite-edge) {
      transition-delay: 0.1s;
    }

    :root[data-theme='dark'] .ray {
      transition-delay: 0s;
    }
  }

  /* Icon-only buttons: the label is the accessible name and shows as a hint below on hover or keyboard focus. */
  .theme-toggle:has(.theme-toggle-hint) {
    position: relative;
  }

  .theme-toggle-hint {
    background: var(--color-text);
    border-radius: 0.375rem;
    color: var(--color-background);
    font-size: 0.8125rem;
    font-weight: 600;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    line-height: 1.2;
    opacity: 0;
    padding: 0.375rem 0.625rem;
    pointer-events: none;
    position: absolute;
    translate: 0 -0.25rem;
    white-space: nowrap;
  }

  .theme-toggle:hover .theme-toggle-hint,
  .theme-toggle:focus-visible .theme-toggle-hint {
    opacity: 1;
    translate: 0 0;
  }

  @media (hover: none) {
    .theme-toggle:hover:not(:focus-visible) .theme-toggle-hint {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle-hint {
      transition:
        opacity 0.2s ease,
        translate 0.2s ease;
    }
  }
</style>
